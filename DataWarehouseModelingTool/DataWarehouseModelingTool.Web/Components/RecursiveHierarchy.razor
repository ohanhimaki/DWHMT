	private void moveThroughElementNodes(Element? elementNode, int i)
	{
		foreach (Reference? childElement in elementNode.referenced)
		{

			if (childElement.sourceElement.referenced.Count() > 0)
			{
				//listBox1.Items.Add(child.Parent); //Do what you want to do with the nodes here
				Console.WriteLine("Node " + i + ": " + childElement.name);
				i++;
				moveThroughElementNodes(childElement.sourceElement, i);
				
			}
			else
			{
				//listBox1.Items.Add(child.Parent); // And here
				
				Console.WriteLine("Last Node: " + childElement.name);


			}
			i = 0;
		}
	}

